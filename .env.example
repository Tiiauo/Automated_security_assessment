# 复制为 .env 后填写；.env 不得提交
# 说明见 PRD 附录 E

# ---- 数据库（经 SSH 隧道到达虚拟机上的 db 服务）----
POSTGRES_DB=sec_eval
POSTGRES_USER=sec_eval
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sec_eval:change_me@127.0.0.1:5432/sec_eval

# ---- 必需密钥 ----
# 生成方式：openssl rand -hex 32
JWT_SECRET=
# 生成方式：openssl rand -base64 32（必须是 32 字节）
DATA_ENCRYPTION_KEY=

# ---- 运行环境 ----
DATA_ROOT=./data
# 本地 http 开发置 false；生产必须 true 且部署于 HTTPS
COOKIE_SECURE=true
# 1 = 使用内置固定模型响应，仅用于开发与自动化测试
LLM_MOCK=0
CORS_ALLOW_ORIGINS=
# ---- 远程 Docker（虚拟机）----
# 先运行 scripts/docker-tunnel.sh 并保持隧道开启；Docker API 不直接暴露在网络上
# 后端只通过该地址操作虚拟机 Docker，不需要 SSH 凭据
DOCKER_HOST=tcp://127.0.0.1:2375
LOG_LEVEL=info
